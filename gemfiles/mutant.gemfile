# frozen_string_literal: true

# Written by hand, not generated by Appraisal. Mutant needs Ruby 3.3 or newer,
# above this gem's 3.1 floor, so it cannot join the default Gemfile that every
# CI Ruby installs. Run it with:
#
#   BUNDLE_GEMFILE=gemfiles/mutant.gemfile bundle exec mutant run

eval_gemfile '../Gemfile'

gem 'mutant-rspec', '~> 0.17.1', require: false
